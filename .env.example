# Environment Variables Template
# ==========================================
# Copy this file to .env.local for local development.
# In Vercel, set these in Project Settings -> Environment Variables.

# --- Client-side Config (Exposed via Vite) ---
# Note: VITE_* variables are embedded in the client build and visible in browser source code.
# Do NOT store server passwords, database connection strings, or secret keys here.
VITE_SITE_URL=http://localhost:5173

# --- Admin Credentials (Local dev fallback) ---
# For production on Vercel, authenticate through a secure serverless backend.
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=spps2026

