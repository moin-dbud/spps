# ==========================================
# PM Shri Savitribai Phule School Website
# Environment Variables Template (.env.example)
# ==========================================
# Instructions:
# 1. Copy this file to .env (or .env.local) for local development:
#    cp .env.example .env
# 2. In Vercel, set these in Project Settings -> Environment Variables.
#
# IMPORTANT:
# - Never commit real credentials, database passwords, or secret tokens.
# - Keep .env listed in .gitignore.

# ==========================================
# 1. MongoDB Database Configuration
# ==========================================
# Your MongoDB Atlas connection string (or local mongodb:// connection string).
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# The MongoDB database name (default: spps_db)
MONGODB_DB_NAME=spps_db

# ==========================================
# 2. Authentication & Security
# ==========================================
# Secret key used for signing / encrypting session tokens (generate a long random 32+ character string)
SESSION_SECRET=your_long_random_session_secret_change_in_production_32chars

# Optional: Initial admin password used when auto-seeding the first super admin on an empty database
INITIAL_ADMIN_PASSWORD=spps2026

# ==========================================
# 3. Client-side Configuration (Exposed via Vite)
# ==========================================
# Base URL for the site (used for canonical URLs and metadata)
VITE_SITE_URL=http://localhost:5173
