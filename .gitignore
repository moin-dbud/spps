# ==========================================
# PM Shri Savitribai Phule School Website
# Production .gitignore for GitHub + Vercel
# ==========================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build Output ---
dist/
Todo
dist-ssr/
build/
*.tsbuildinfo

# --- Local Environment & Secrets ---
# Never commit credentials, secrets, or local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# --- Logs & Runtime Artifacts ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Vite & Test Caches ---
.vite/
.cache/
coverage/
.turbo/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Temporary Scripts & Intermediate Extraction Files ---
# Intermediate raw XML extraction folders from PowerPoint files (over 50MB, duplicates of public/ assets)
docs/pptx1_extracted/
docs/pptx2_extracted/
# Temporary scratch/analysis scripts in docs
docs/*.py
docs/contact_sheet.html

# NOTE: The following ARE deliberately tracked in Git:
# - public/assets/images/ (all optimized presentation images)
# - data/settings.json, data/news.json, data/gallery.json (seed content & data defaults)
# - docs/Presentation 2026-27.pptx & docs/Upkram 1.pptx (source of truth presentations)
# - docs/*.txt & docs/*.json (slide analysis references)
# - package.json and package-lock.json
